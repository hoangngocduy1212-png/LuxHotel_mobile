<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient"
    android:fillViewport="true"
    tools:context=".activities.LoginActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Decorative top gold bar -->
        <View
            android:id="@+id/goldBar"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:background="@color/gold_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Card container -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLogin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="40dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="4dp"
            app:cardElevation="24dp"
            app:layout_constraintBottom_toTopOf="@+id/tvFooter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/goldBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingTop="40dp"
                android:paddingEnd="32dp"
                android:paddingBottom="36dp">

                <!-- Logo / Icon area -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_marginBottom="28dp">

                    <ImageView
                        android:id="@+id/ivLogo"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_hotel_logo"
                        android:contentDescription="@string/logo_desc" />

                    <!-- App name -->
                    <TextView
                        android:id="@+id/tvAppName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/app_name"
                        android:letterSpacing="0.25"
                        android:textColor="@color/gold_primary"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTagline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/tagline"
                        android:letterSpacing="0.15"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />

                    <!-- Decorative divider -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="40dp"
                            android:layout_height="1dp"
                            android:background="@color/gold_secondary" />

                        <View
                            android:layout_width="5dp"
                            android:layout_height="5dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_diamond" />

                        <View
                            android:layout_width="40dp"
                            android:layout_height="1dp"
                            android:background="@color/gold_secondary" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Welcome text -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_back"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="20dp"
                    android:gravity="center" />

                <!-- Username field -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_username"
                    android:textColor="@color/gold_secondary"
                    android:textSize="10sp"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/LuxInputLayout"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/gold_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_username"
                        android:inputType="text"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp"
                        android:imeOptions="actionNext" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password field -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_password"
                    android:textColor="@color/gold_secondary"
                    android:textSize="10sp"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="28dp"
                    style="@style/LuxInputLayout"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="@color/gold_secondary"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/gold_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_password"
                        android:inputType="textPassword"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp"
                        android:imeOptions="actionDone" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Error message -->
                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center"
                    android:textColor="@color/error_color"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="Tên đăng nhập hoặc mật khẩu không đúng." />

                <!-- Login button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/btn_login"
                    android:textColor="@color/bg_dark"
                    android:textSize="13sp"
                    android:letterSpacing="0.12"
                    android:textStyle="bold"
                    app:backgroundTint="@color/gold_primary"
                    app:cornerRadius="2dp"
                    app:rippleColor="@color/gold_ripple" />

                <!-- Loading indicator -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:indeterminateTint="@color/gold_primary"
                    android:visibility="gone" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Footer -->
        <TextView
            android:id="@+id/tvFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/footer_text"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:letterSpacing="0.1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
